page{background:#f6f5ef;color:#263e35;font-family:-apple-system,BlinkMacSystemFont,'PingFang SC',sans-serif;font-size:28rpx}view,text,input,button{box-sizing:border-box}button::after{border:0}button{font-size:27rpx;border-radius:24rpx;background:#e8ede5;color:#294d3d;margin:0}button.primary{background:#315a45;color:#fff} .page{padding:36rpx 32rpx 70rpx}.eyebrow{font-size:21rpx;letter-spacing:5rpx;color:#7c8d7e}.title{font-size:58rpx;font-weight:600;line-height:1.35;margin:22rpx 0}.muted{color:#7a8479;font-size:25rpx;line-height:1.8}.card{background:#fffef9;border:1rpx solid #e4e7dc;border-radius:30rpx;padding:30rpx;margin-top:24rpx}.row{display:flex;align-items:center;justify-content:space-between;gap:18rpx}.chips{display:flex;gap:14rpx;margin:26rpx 0;flex-wrap:wrap}.chip{padding:15rpx 25rpx;border-radius:40rpx;background:#ebece4;color:#687769;font-size:24rpx}.chip.active{background:#315a45;color:white}.badge{font-size:21rpx;border-radius:12rpx;padding:9rpx 14rpx;background:#eff1e7;color:#5c7258}.high,.toxic{background:#f6e4db;color:#9f513b}.caution{background:#f8edcd;color:#8d702a}.low{background:#e5eee0;color:#47683e}.section{font-size:33rpx;font-weight:600;margin:34rpx 0 16rpx}.body{line-height:1.9;font-size:27rpx;white-space:pre-line}.notice{background:#efe8d8;color:#7a6846;padding:24rpx;border-radius:20rpx;font-size:24rpx;line-height:1.8;margin-top:25rpx}.link{color:#466d54;font-size:24rpx}.empty{text-align:center;padding:70rpx 20rpx}.plant-icon{font-size:78rpx;color:#65826a;width:110rpx;height:120rpx;display:flex;align-items:center;justify-content:center;background:#edf0e6;border-radius:22rpx}.name{font-size:33rpx;font-weight:600}.latin{font-size:21rpx;color:#899084;margin:8rpx 0 17rpx}.footer{text-align:center;letter-spacing:3rpx;margin-top:44rpx;color:#919889;font-size:20rpx}
