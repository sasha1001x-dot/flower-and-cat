.forum-input{padding:25rpx;background:#fffef9;border:1rpx solid #e1e6d9;border-radius:22rpx;margin:25rpx 0;font-size:26rpx;height:95rpx}.forum-text{box-sizing:border-box;width:100%;height:400rpx;background:#fffef9;border:1rpx solid #e1e6d9;border-radius:22rpx;padding:25rpx;font-size:27rpx;line-height:1.9;margin:25rpx 0}.reply-text{height:230rpx}.post-title{margin:20rpx 0 12rpx}.post-excerpt{font-size:26rpx;color:#7e8c75;line-height:1.9;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;margin-bottom:18rpx}.forum-body{white-space:pre-wrap;word-break:break-all;margin:30rpx 0}.title{font-size:46rpx}

.community-page{padding:28rpx 32rpx 38rpx}.community-page .eyebrow{font-size:18rpx;letter-spacing:3rpx}.community-page .muted{font-size:22rpx}.community-hero{display:flex;align-items:center;justify-content:space-between;margin:24rpx 0}.community-hero .title{font-size:40rpx;margin:0 0 12rpx}.community-mark{font-size:75rpx;color:#9aa786}.local-strip{padding:17rpx 19rpx;background:#eceee4;border-radius:14rpx;font-size:20rpx;color:#7b856e}.local-strip text,.rules-toggle text{float:right}.local-detail{font-size:21rpx;line-height:1.85;margin-top:12rpx;color:#7b856e}.guide-heading{font-size:29rpx;font-weight:600;margin:32rpx 0 18rpx;display:flex;align-items:center;justify-content:space-between}.guide-heading text{font-size:19rpx;font-weight:400;color:#8c9583}.guide-list{background:#fffef9;border:1rpx solid #e5e7dc;border-radius:22rpx;overflow:hidden}.guide-item+.guide-item{border-top:1rpx solid #eceee5}.guide-question{display:flex;align-items:center;justify-content:space-between;gap:20rpx;padding:22rpx;font-size:25rpx;line-height:1.7}.guide-question>view{flex:1}.guide-tag{font-size:18rpx;color:#8c987e;margin-bottom:4rpx}.guide-answer{padding:0 22rpx 24rpx;font-size:22rpx;line-height:1.9;color:#74806c}.guide-action{font-size:22rpx;margin-top:16rpx;color:#315a45}.community-feed-heading{display:flex;justify-content:space-between;align-items:center;margin-top:36rpx;font-size:29rpx;font-weight:600}.community-feed-heading text{display:block;font-size:19rpx;font-weight:400;color:#929a89;margin-top:7rpx}.compose-small{width:auto;max-width:none;margin:0;padding:0 24rpx;font-size:22rpx;line-height:2.5;background:#315a45;color:#fffef9;border-radius:30rpx}.community-page .forum-input{font-size:23rpx;height:84rpx;margin:22rpx 0 18rpx}.forum-filter-scroll{white-space:nowrap}.forum-filters{display:inline-flex;gap:12rpx;padding-bottom:8rpx}.forum-filters .chip{font-size:21rpx;padding:12rpx 22rpx;white-space:nowrap;margin:0}.community-empty{display:flex;align-items:center;gap:24rpx;padding:30rpx 8rpx;font-size:24rpx}.empty-sprig{font-size:60rpx;color:#a2ac91}.community-empty view text{display:block;font-size:21rpx;color:#919987;margin-top:10rpx}.rules-toggle{font-size:21rpx;border-top:1rpx solid #e4e7dc;padding-top:22rpx;color:#7c896f}.community-urgent{font-size:19rpx;line-height:1.8;color:#a28c76;margin-top:18rpx}.community-post .post-excerpt{font-size:23rpx}.community-page .notice{font-size:21rpx}
.community-feed-heading .compose-small{width:150rpx;flex-shrink:0;margin:0}
