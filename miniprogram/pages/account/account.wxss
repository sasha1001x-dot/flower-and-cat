.avatar{width:145rpx;height:145rpx;border-radius:50%;background:#e6edde;color:#729068;font-size:100rpx;display:flex;align-items:center;justify-content:center;padding:0;margin-bottom:18rpx}.avatar image{width:100%;height:100%}.nickname{padding:20rpx;background:#f2f3ed;border-radius:15rpx;height:90rpx;margin-bottom:25rpx}.card button{margin-top:20rpx}.page>button{margin-top:28rpx}

.identity-title{display:inline-block;padding:15rpx 24rpx;border-radius:30rpx;background:#e5ecd9;color:#4e693f;font-size:28rpx;margin-bottom:20rpx}.identity-options{margin:20rpx 0}.identity-option{border:2rpx solid #e2e6db;padding:22rpx;border-radius:20rpx;margin-top:15rpx;font-size:25rpx}.identity-option.selected{border-color:#527351;background:#edf2e5}.identity-option .body{font-weight:600;margin-top:5rpx}

.identity-option{display:flex;align-items:center;gap:18rpx;padding:25rpx 18rpx;min-height:176rpx;background:#faf9f2;border-radius:26rpx;position:relative}.identity-face{width:130rpx;height:130rpx;flex-shrink:0}.identity-copy{flex:1;min-width:0}.identity-name{font-size:32rpx;font-weight:600;line-height:1.5;color:#344f3a}.identity-label{font-size:23rpx;color:#88917d;margin-top:8rpx}.identity-check{width:32rpx;height:32rpx;border:2rpx solid #d5ddcb;border-radius:50%;font-size:22rpx;line-height:28rpx;text-align:center;color:#fff;flex-shrink:0}.identity-option.selected .identity-check{background:#527351;border-color:#527351}.identity-option.selected{background:#edf2e5;border-color:#759268}

.identity-option{padding:28rpx 18rpx;gap:24rpx;min-height:192rpx;border-color:#e7e7df;background:#fbfaf6}.identity-face{width:144rpx;height:144rpx}.identity-name{font-size:32rpx;letter-spacing:1rpx;font-weight:600;color:#39473b}.identity-label{font-size:22rpx;color:#92968a;margin-top:9rpx}.identity-option.selected{background:#f0f2e9;border-color:#9caa8f}.identity-check{width:29rpx;height:29rpx;line-height:25rpx}.identity-option.selected .identity-check{background:#6e8063;border-color:#6e8063}

.favorites-shortcut{margin-top:22rpx;font-size:25rpx;text-align:left;padding:12rpx 20rpx}

.account-hero{text-align:center;padding:45rpx 0}.account-avatar{width:170rpx;height:170rpx;border-radius:50%;background:#edf0e5;overflow:hidden;display:flex;align-items:center;justify-content:center;margin:auto;font-size:90rpx}.account-avatar image{width:100%;height:100%}.account-name{font-size:44rpx;font-weight:600;margin:28rpx 0 20rpx}.account-hero button{font-size:24rpx;margin-top:18rpx}.account-stats{display:flex;background:#fffef9;border:1rpx solid #e1e6d9;border-radius:30rpx;padding:30rpx 0}.account-stats button{width:50%;font-size:24rpx;color:#86907e}.account-stats button+button{border-left:1rpx solid #e1e6d9;border-radius:0}.stat-number{font-size:46rpx;font-weight:600;color:#315a45;margin-bottom:10rpx}.account-menu{border:1rpx solid #e1e6d9;border-radius:28rpx;background:#fffef9;padding:0 25rpx}.account-menu button{text-align:left;width:100%;font-size:26rpx;padding:30rpx 0}.account-menu button+button{border-top:1rpx solid #e1e6d9}.about-title{margin-top:28rpx}.account-record{white-space:pre-wrap;word-break:break-all}

.growth-entry{padding:30rpx;border-radius:28rpx;background:#e8eedf;margin-top:24rpx}.growth-entry .muted{margin-top:12rpx}
