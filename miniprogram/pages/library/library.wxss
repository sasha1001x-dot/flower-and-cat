.library-page{padding-top:30rpx}.library-header{display:flex;align-items:center;justify-content:space-between;margin-bottom:22rpx}.library-header .title{font-size:48rpx;margin:12rpx 0 0}.collection-link{background:none;padding:10rpx 0;font-size:25rpx;color:#718269}.library-notice{padding:24rpx;background:#edf0e6;border-radius:20rpx;color:#65775a}.notice-heading{display:flex;justify-content:space-between;gap:14rpx;font-size:24rpx;font-weight:500}.notice-heading text:last-child{font-size:21rpx;flex-shrink:0}.notice-summary{font-size:23rpx;line-height:1.75;margin-top:12rpx}.notice-paragraph{font-size:24rpx;line-height:1.85;margin-top:18rpx}.emergency-link{font-size:22rpx;color:#9c6848;margin-top:16rpx;padding-top:14rpx;border-top:1rpx solid #dce2d3}.search{display:flex;align-items:center;gap:16rpx;padding:23rpx 25rpx;margin-top:25rpx}.search input{flex:1;font-size:25rpx}.quick-search{display:flex;gap:23rpx;align-items:center;font-size:23rpx;color:#63775a;margin:20rpx 0 30rpx}.quick-search text:first-child{color:#939c8a}.library-filters{display:flex;align-items:center;justify-content:space-between;padding-bottom:22rpx;border-bottom:1rpx solid #dfe4d7}.pet-switch{display:flex;padding:6rpx;border-radius:40rpx;background:#e9ece2}.pet-switch text{padding:12rpx 26rpx;font-size:24rpx;color:#7b8771}.pet-switch .selected{background:#fffef9;border-radius:30rpx;color:#315a45;box-shadow:0 2rpx 7rpx #263e350b}.risk-select{font-size:24rpx;color:#5f7157}.library-toolbar{display:flex;justify-content:space-between;align-items:center;margin-top:25rpx;margin-bottom:10rpx}.sort-switch{display:flex;gap:25rpx;font-size:24rpx;color:#9aa28f}.sort-switch .selected{color:#315a45;font-weight:600}.result-count{font-size:22rpx;color:#8a947f}.catalog-item{padding:30rpx 0;border-bottom:1rpx solid #e2e6db}.catalog-item-top{display:flex;align-items:flex-start;justify-content:space-between;gap:15rpx}.catalog-name{font-size:30rpx;font-weight:600;line-height:1.5;flex:1}.catalog-item .badge{font-size:20rpx;flex-shrink:0}.catalog-latin{font-size:25rpx;font-style:italic;color:#6d7e62;margin-top:8rpx}.catalog-taxonomy{font-size:23rpx;color:#8a947e;margin-top:13rpx}.catalog-alias{font-size:23rpx;color:#8a947e;line-height:1.75;margin-top:5rpx}.catalog-footnote{font-size:21rpx;color:#929b87;line-height:1.8;margin-top:30rpx;text-align:center}
