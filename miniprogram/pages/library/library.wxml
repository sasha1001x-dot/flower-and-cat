<view class="page library-page"><view class="library-header"><view><view class="eyebrow">PLANT LIBRARY</view><view class="title">植物图鉴</view></view><button class="collection-link" bindtap="saved">{{saved ? '查看全部' : '♡ 收藏'}}</button></view><view class="library-notice"><view class="notice-heading" bindtap="toggleNotice"><text>{{notice.title}}</text><text>{{noticeOpen ? '收起 −' : '展开 ＋'}}</text></view><view class="notice-summary">{{notice.summary}}</view><view wx:if="{{noticeOpen}}"><view class="notice-paragraph" wx:for="{{notice.paragraphs}}" wx:key="*this">{{item}}</view><view class="muted">{{notice.attribution}}</view><text class="link" bindtap="noticeSource">复制 ASPCA 参考说明链接 ↗</text></view><view class="emergency-link" bindtap="emergency">疑似误食或出现不适？及时联系兽医 ↗</view></view><view class="card search"><text>⌕</text><input placeholder="搜索中文名、学名或常用名" value="{{q}}" bindinput="input" confirm-type="search"/></view><view class="quick-search"><text>常查</text><text data-value="苏铁" bindtap="quick">苏铁</text><text data-value="郁金香" bindtap="quick">郁金香</text><text data-value="杜鹃" bindtap="quick">杜鹃</text><text data-value="百合" bindtap="quick">百合</text></view><view class="library-filters"><view class="pet-switch"><text class="{{pet === 'cat' ? 'selected' : ''}}" data-value="cat" bindtap="pet">猫咪</text><text class="{{pet === 'dog' ? 'selected' : ''}}" data-value="dog" bindtap="pet">狗狗</text></view><picker range="{{riskOptions}}" value="{{riskIndex}}" bindchange="riskChange"><view class="risk-select">{{riskOptions[riskIndex]}} ▾</view></picker></view><view class="library-toolbar"><view class="sort-switch"><text class="{{order === 'common' ? 'selected' : ''}}" data-value="common" bindtap="sort">按常用名</text><text class="{{order === 'scientific' ? 'selected' : ''}}" data-value="scientific" bindtap="sort">按学名</text></view><text class="result-count">{{saved ? '收藏 · ' : ''}}{{items.length}} 个结果</text></view><view wx:if="{{ambiguity}}" class="notice"><view>{{ambiguity.title}}</view><view class="notice-paragraph">{{ambiguity.message}}</view></view><view class="catalog-item" wx:for="{{items}}" wx:key="id" data-id="{{item.id}}" bindtap="open"><view class="catalog-item-top"><view class="catalog-name">{{item.name}}</view><text class="badge {{item.risk}}">{{item.label}}</text></view><view class="catalog-latin">{{item.latin}}</view><view class="catalog-taxonomy">{{item.family}} · {{item.genus}} 属</view><view wx:if="{{item.aliasSummary}}" class="catalog-alias">常用名：{{item.aliasSummary}}</view></view><view wx:if="{{!items.length}}" class="empty"><view class="name">没有匹配的植物</view><view class="muted">换个名字或调整筛选试试。未收录不代表安全。</view></view><view class="catalog-footnote">{{total}} 个分类档案 · 含属级总览、物种及园艺类群<view>来源与证据适用范围见详情，资料仍待专业复核。</view></view></view>
