.growth-stats{display:flex;justify-content:space-around;text-align:center;margin:36rpx 0;font-size:22rpx;color:#8a947d}.growth-stats text{font-size:42rpx;color:#315a45;font-weight:600}.badge-grid{display:grid;grid-template-columns:1fr 1fr;gap:20rpx}.growth-badge{text-align:center;padding:30rpx 15rpx;border:1rpx solid #e1e6d9;background:#f0f0e9;border-radius:26rpx}.growth-badge.earned{background:#edf2e2;border-color:#a6b893}.badge-flower{font-size:65rpx;color:#a9b09e}.earned .badge-flower{color:#638157}.growth-badge .name{font-size:26rpx}.growth-badge .muted{font-size:21rpx}.badge-status{font-size:22rpx;color:#708363;margin-top:15rpx}.card .primary{font-size:24rpx;padding:14rpx 20rpx;margin:0}.card progress{margin-top:24rpx}.body>view{margin-top:20rpx}
