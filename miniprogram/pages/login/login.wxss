.login{padding-top:70rpx}.login-flower{font-size:160rpx;color:#74916b;margin:70rpx 0 30rpx}.consent{font-size:24rpx;line-height:2;margin:40rpx 0 24rpx;color:#73806e}.title view{font-size:49rpx}

.onboarding-step{font-size:23rpx;color:#89957e;margin:30rpx 0}.onboarding-options{margin:35rpx 0 25rpx}.onboarding-option{width:100%;display:flex;align-items:center;gap:22rpx;padding:22rpx 18rpx;min-height:180rpx;margin-top:18rpx;background:#fbfaf6;border:2rpx solid #e3e6da;border-radius:28rpx;text-align:left;line-height:1.5;white-space:normal}.onboarding-option.selected{background:#edf1e5;border-color:#8da27d}.onboarding-face{width:125rpx;height:125rpx;flex-shrink:0}.onboarding-copy{flex:1;min-width:0}.onboarding-name{font-size:31rpx;font-weight:600;color:#39473b}.onboarding-label{font-size:23rpx;color:#8a947e;margin-top:9rpx}.onboarding-check{width:30rpx;height:30rpx;line-height:26rpx;border:2rpx solid #d3dcc8;border-radius:50%;color:transparent;text-align:center;font-size:22rpx;flex-shrink:0}.selected .onboarding-check{background:#6e8063;border-color:#6e8063;color:white}.onboarding-note{font-size:22rpx;margin-bottom:28rpx}

.login{padding:34rpx 36rpx 38rpx}.login .title{font-size:49rpx;line-height:1.5}.login .muted{font-size:23rpx}.login-flower{font-size:100rpx;margin:38rpx 0 24rpx}.onboarding-step{font-size:21rpx;margin:28rpx 0 22rpx}.onboarding-options{width:100%;margin:28rpx 0 20rpx}.onboarding-option{box-sizing:border-box;width:100%;max-width:none;margin:16rpx 0 0;padding:20rpx 22rpx;min-height:145rpx;gap:18rpx;border-radius:24rpx}.onboarding-face{width:98rpx;height:98rpx}.onboarding-name{font-size:30rpx;white-space:nowrap;line-height:1.45;letter-spacing:0}.onboarding-label{font-size:21rpx;font-weight:400;margin-top:7rpx}.onboarding-check{width:28rpx;height:28rpx;line-height:24rpx;font-size:20rpx}.onboarding-note{font-size:20rpx!important;line-height:1.8;margin-bottom:24rpx}.login .primary{box-sizing:border-box;width:100%;max-width:none;font-size:26rpx;padding:5rpx 14rpx;line-height:2.4}.login .notice{font-size:21rpx;padding:20rpx}.login .card{font-size:24rpx}.consent{font-size:22rpx;margin-top:28rpx}.login-garden{height:155rpx;position:relative;margin-top:12rpx;pointer-events:none}.garden-base{width:100%;height:155rpx;opacity:.65}.garden-butterfly{position:absolute;width:52rpx;height:50rpx;top:26rpx;left:65%;animation:garden-float 8s ease-in-out infinite;opacity:.8}.login .footer{margin-top:2rpx;font-size:19rpx;letter-spacing:2rpx}@keyframes garden-float{0%,100%{transform:translate(0,0) rotate(-10deg)}50%{transform:translate(-20rpx,-12rpx) rotate(8deg)}}

.onboarding-nickname{margin-top:25rpx;font-size:23rpx}.onboarding-nickname input{height:82rpx;background:#fffef9;border:1rpx solid #e4e7dc;border-radius:18rpx;padding:0 20rpx;font-size:25rpx;margin-top:14rpx}.nickname-hint{font-size:19rpx;line-height:1.8;color:#8a947e;margin-top:9rpx}
