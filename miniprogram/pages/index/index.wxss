.home-page{padding-top:30rpx}.home-hero{margin:38rpx 0 28rpx}.home-hero .title{font-size:52rpx;line-height:1.55;margin:0}.home-hero .title view{font-size:39rpx;margin-top:10rpx}.home-hero .muted{margin-top:22rpx;font-size:24rpx}.home-search{display:flex;align-items:center;gap:18rpx;padding:20rpx 24rpx;background:#fffef9;border:1rpx solid #e4e7dc;border-radius:28rpx;min-height:98rpx}.home-search .search-submit{flex:0 0 38rpx;width:38rpx;min-width:38rpx;padding:0;margin:0;line-height:50rpx;background:transparent;border-radius:0;font-size:35rpx;text-align:left}.home-search input{flex:1;width:0;min-width:0;height:56rpx;font-size:25rpx;text-align:left}.camera{margin-top:22rpx;border-radius:28rpx;background:#315a45;color:#fff;padding:34rpx 30rpx;min-height:180rpx;display:flex;justify-content:space-between;align-items:center}.camera .name{font-size:31rpx}.camera-sub{font-size:23rpx;color:#d7e2d0;margin-top:13rpx}.camera-art{font-size:88rpx;line-height:1;color:#cedbb4}.common-plants{margin-top:38rpx}.common-heading{display:flex;align-items:baseline;justify-content:space-between;gap:12rpx}.common-heading .name{font-size:29rpx}.common-heading .muted{font-size:21rpx}.common-grid{display:flex;gap:16rpx;margin-top:22rpx}.common-plant{flex:1;min-width:0;text-align:left;padding:22rpx 18rpx;background:#efefe6;border:1rpx solid #e2e5d9;border-radius:24rpx;line-height:1.5}.common-symbol{font-size:48rpx;color:#7e9473;display:block;line-height:1;margin-bottom:18rpx}.common-name{font-size:27rpx;font-weight:600}.common-hint{font-size:20rpx;color:#8b9480;margin-top:8rpx}.common-note{font-size:20rpx;color:#959c8d;margin-top:20rpx;line-height:1.8}

.home-page{padding:30rpx 32rpx 40rpx}.home-page .eyebrow{font-size:20rpx;letter-spacing:3rpx}.home-page .link{font-size:22rpx}.home-hero{margin:32rpx 0 26rpx}.home-hero .title{font-size:49rpx}.home-hero .title view{font-size:37rpx}.home-hero .muted{font-size:23rpx}.common-plant{width:0;max-width:none;margin:0}.common-hint{font-size:19rpx}.common-note{font-size:19rpx}.home-journal{position:relative;overflow:hidden;background:#e9eddf;border-radius:26rpx;padding:28rpx 28rpx 25rpx;margin-top:32rpx;min-height:228rpx}.journal-kicker{font-size:17rpx;letter-spacing:3rpx;color:#899779}.journal-title{font-size:34rpx;line-height:1.5;font-weight:500;margin-top:17rpx;position:relative;z-index:1}.journal-bottom{display:flex;align-items:center;gap:20rpx;font-size:21rpx;color:#738263;margin-top:17rpx;position:relative;z-index:1}.journal-arrow{font-size:30rpx}.journal-garden{position:absolute;width:340rpx;height:150rpx;right:-10rpx;bottom:6rpx;opacity:.6}.home-endnote{text-align:center;font-size:19rpx;color:#99a08f;margin:24rpx 0 10rpx;letter-spacing:2rpx}
